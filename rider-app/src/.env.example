# Where the logistics API runs, as seen from the PHONE.
#  - Real phone: your computer's address on the Wi-Fi, for example http://192.168.1.20:3000
#    (on Windows, run "ipconfig" and read the IPv4 Address of your Wi-Fi adapter)
#  - Android emulator: http://10.0.2.2:3000
#  - iPhone simulator: http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
